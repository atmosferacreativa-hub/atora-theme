{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "800px",
			"wideSize": "1080px"
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Source Sans 3\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "Source Sans 3",
					"slug": "source-sans-3",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-wght.woff2"
							]
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-italic-wght.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"Sora\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "Sora",
					"slug": "sora",
					"fontFace": [
						{
							"fontFamily": "Sora",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/sora-latin-wght.woff2"
							]
						}
					]
				}
			]
		},
		"color": {
			"palette": [
				{
					"color": "#1F5BFF",
					"name": "Azul",
					"slug": "blue"
				},
				{
					"color": "#0B2C8F",
					"name": "Azul profundo",
					"slug": "blue-deep"
				},
				{
					"color": "#071B55",
					"name": "Azul tinta",
					"slug": "blue-ink"
				},
				{
					"color": "#FFB020",
					"name": "Ámbar",
					"slug": "amber"
				},
				{
					"color": "#FFF1D1",
					"name": "Ámbar suave",
					"slug": "amber-soft"
				},
				{
					"color": "#10162A",
					"name": "Tinta",
					"slug": "ink"
				},
				{
					"color": "#4A5270",
					"name": "Tinta suave",
					"slug": "ink-2"
				},
				{
					"color": "#F3F6FF",
					"name": "Fondo azul",
					"slug": "bg-2"
				},
				{
					"color": "#DCE2F4",
					"name": "Línea",
					"slug": "line"
				},
				{
					"color": "#FFFFFF",
					"name": "Blanco",
					"slug": "white"
				},
				{
					"color": "#1F55E6",
					"name": "Azul ATORA (anterior)",
					"slug": "meridian-blue"
				},
				{
					"color": "#F2EEE6",
					"name": "Arena",
					"slug": "meridian-sand"
				},
				{
					"color": "#172033",
					"name": "Tinta (anterior)",
					"slug": "meridian-ink"
				},
				{
					"color": "#ECE4D8",
					"name": "Arcilla",
					"slug": "meridian-clay"
				}
			]
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "1.5rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sora)",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.05"
				}
			}
		},
		"color": {
			"background": "var(--atora-bg)",
			"text": "var(--atora-text)"
		}
	}
}
